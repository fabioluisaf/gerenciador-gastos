# Copie para .env e ajuste. O .env não vai para o git.

# Banco
DB_NOME=gerenciador_gastos
DB_USERNAME=postgres
DB_PASSWORD=troque-esta-senha

# Versões (tags das imagens e versão exibida pela API)
VERSAO_APP=0.0.0-des
VERSAO_WEB=latest

# Portas no host
DB_PORTA_HOST=5433
API_PORTA_HOST=8080
WEB_PORTA_HOST=4200

# Caminho do repositório do frontend, relativo a esta pasta
FRONTEND_PATH=../gerenciador-gastos-frontend-angular
